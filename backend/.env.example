# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farmacontrol

# development para execução local; production exige WSGI, HTTPS e chave válida.
APP_ENV=development
APP_DEBUG=false
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Vazio em development usa chave temporária (sessões expiram ao reiniciar).
SECRET_KEY=
SESSION_HOURS=8
# "Lembrar acesso" mantém a sessão pelo período acima. Sem a opção, ela termina ao fechar o navegador.
COOKIE_SECURE=false
# Vazio: somente mesma origem. Para integrações, lista explícita sem * ou null.
ALLOWED_ORIGINS=

# Brevo SMTP: use a chave SMTP temporária e o remetente verificado no painel.
# Nunca versione a senha real; ela deve ficar somente em backend/.env ou no provedor de deploy.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FarmaControl

# URL pública usada nos links de convite. Em produção, informe a URL HTTPS publicada.
APP_PUBLIC_URL=http://localhost:5000
